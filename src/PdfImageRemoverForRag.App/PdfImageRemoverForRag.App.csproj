<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK TFM (not plain net8.0-windows) so the WinRT projections
         for Windows.Data.Pdf are available â€” the usage-locations window renders
         full PDF pages with the OS's own PDF renderer, so no native PDFium/Skia
         binary has to be bundled. 19041 = Windows 10 2004, well below Win11. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>PdfImageRemoverForRag.App</RootNamespace>
    <!-- Executable/assembly base name (no .App suffix): PdfImageRemoverForRag.exe -->
    <AssemblyName>PdfImageRemoverForRag</AssemblyName>

    <!-- App icon: the .exe icon (Explorer/taskbar) and, embedded, the window
         title-bar icon (loaded in MainForm). -->
    <ApplicationIcon>appicon.ico</ApplicationIcon>

    <!-- Product version plus a plain integer build number (no date, so it never
         looks stale). Both are shown in About so the exact build is identifiable
         inside the app. Bump BuildNumber on every published update AND every
         binary put on the VM, so no two builds can claim the same number.
         Version, packaging/Package.appxmanifest and the git tag move together;
         what decides Major/Minor/Patch is in CLAUDE.md.
         InformationalVersion interpolates Version rather than repeating it: it
         said 1.0.0 while the Store said 1.0.3.0, because a literal here does not
         follow a bump made two lines above. -->
    <Version>1.2.2</Version>
    <BuildNumber>132</BuildNumber>
    <InformationalVersion>$(Version)+$(BuildNumber)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- Embed the icon so the window title bar can load it (see MainForm). -->
  <ItemGroup>
    <EmbeddedResource Include="appicon.ico">
      <LogicalName>appicon.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfImageRemoverForRag.Core\PdfImageRemoverForRag.Core.csproj" />
    <ProjectReference Include="..\PdfImageRemoverForRag.Infrastructure\PdfImageRemoverForRag.Infrastructure.csproj" />
  </ItemGroup>
</Project>
